{
  "name": "grro-cloud/wordpress-starter",
  "description": "WordPress for Grro Cloud: core from Composer, settings from environment variables.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-mysqli": "*",
    "johnpbloch/wordpress-core-installer": "^2.0",
    "johnpbloch/wordpress-core": "^6.8"
  },
  "config": {
    "allow-plugins": { "johnpbloch/wordpress-core-installer": true },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": { "wordpress-install-dir": "htdocs/wp" }
}
