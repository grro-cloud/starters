{
  "name": "grro-hono-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hono on Node.js starter for Grro",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsc --watch & node --watch dist/server.js",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
