{
  "name": "grro-sveltekit-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit starter for Grro, running on Node with adapter-node",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "PROTOCOL_HEADER=${PROTOCOL_HEADER:-x-forwarded-proto} ADDRESS_HEADER=${ADDRESS_HEADER:-x-forwarded-for} XFF_DEPTH=${XFF_DEPTH:-1} node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check && npm run build && node --test"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
