{
  "name": "grro-astroship-starter",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "description": "Astroship marketing site theme, adapted to build as a static site on Grro",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/bx": "1.2.3",
    "@iconify-json/simple-icons": "1.2.101",
    "@iconify-json/uil": "1.2.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "astro-icon": "1.2.0",
    "astro-navbar": "2.4.0",
    "astro-seo": "1.2.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5"
  }
}
