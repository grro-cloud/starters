{
  "name": "grro-nestjs-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS starter for Grro",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
